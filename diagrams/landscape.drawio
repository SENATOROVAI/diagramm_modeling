<mxfile host="app.diagrams.net">
  <diagram id="landscape" name="Карта процессов ПАО ОГК-2">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1"
                  connect="1" arrows="1" fold="1" page="1" pageWidth="1200" pageHeight="700"
                  math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Фоновые пояса -->
        <mxCell id="bg1" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=40;" vertex="1" parent="1"><mxGeometry x="20" y="30" width="1140" height="110" as="geometry"/></mxCell>
        <mxCell id="bg2" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=40;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="1140" height="110" as="geometry"/></mxCell>
        <mxCell id="bg3" value="" style="rounded=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;opacity=40;" vertex="1" parent="1"><mxGeometry x="20" y="310" width="1140" height="110" as="geometry"/></mxCell>

        <!-- Метки поясов (шевроны) -->
        <mxCell id="lbl1" value="УПРАВЛЯЮЩИЕ&#10;ПРОЦЕССЫ" style="shape=mxgraph.basic.rectangular_callout;html=1;fillColor=#6c8ebf;fontColor=#ffffff;fontStyle=1;whiteSpace=wrap;direction=east;dx=12;" vertex="1" parent="1"><mxGeometry x="35" y="50" width="150" height="70" as="geometry"/></mxCell>
        <mxCell id="lbl2" value="ОСНОВНЫЕ&#10;ПРОЦЕССЫ" style="shape=mxgraph.basic.rectangular_callout;html=1;fillColor=#82b366;fontColor=#ffffff;fontStyle=1;whiteSpace=wrap;direction=east;dx=12;" vertex="1" parent="1"><mxGeometry x="35" y="190" width="150" height="70" as="geometry"/></mxCell>
        <mxCell id="lbl3" value="ОБЕСПЕЧИВАЮЩИЕ&#10;ПРОЦЕССЫ" style="shape=mxgraph.basic.rectangular_callout;html=1;fillColor=#d79b00;fontColor=#ffffff;fontStyle=1;whiteSpace=wrap;direction=east;dx=12;" vertex="1" parent="1"><mxGeometry x="35" y="330" width="150" height="70" as="geometry"/></mxCell>

        <!-- Управляющие процессы -->
        <mxCell id="u1" value="Стратегическое управление" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="220" y="55" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="u2" value="Бюджетирование и планирование" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="490" y="55" width="240" height="60" as="geometry"/></mxCell>

        <!-- Основные процессы -->
        <mxCell id="m1" value="Производство электро- и теплоэнергии" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="220" y="195" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="m2" value="Реализация энергии на ОРЭМ" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="490" y="195" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="m3" value="Ремонт и техобслуживание оборудования" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="760" y="195" width="250" height="60" as="geometry"/></mxCell>

        <!-- Обеспечивающие процессы -->
        <mxCell id="s1" value="Управление персоналом" style="rounded=1;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;fontStyle=1;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="220" y="335" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="s2" value="Материально-техническое обеспечение" style="rounded=1;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="450" y="335" width="210" height="60" as="geometry"/></mxCell>
        <mxCell id="s3" value="ИТ-обеспечение" style="rounded=1;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="690" y="335" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="s4" value="Финансы и учёт" style="rounded=1;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="335" width="180" height="60" as="geometry"/></mxCell>

        <!-- Подпроцессы HR -->
        <mxCell id="hr1" value="Планирование численности" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="500" width="170" height="55" as="geometry"/></mxCell>
        <mxCell id="hr2" value="Подбор и приём персонала" style="rounded=0;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;whiteSpace=wrap;fontStyle=1;fontSize=12;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="230" y="495" width="190" height="65" as="geometry"/></mxCell>
        <mxCell id="hr3" value="Адаптация" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="450" y="500" width="120" height="55" as="geometry"/></mxCell>
        <mxCell id="hr4" value="Обучение и развитие" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="500" width="160" height="55" as="geometry"/></mxCell>
        <mxCell id="hr5" value="Оценка персонала" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="790" y="500" width="140" height="55" as="geometry"/></mxCell>
        <mxCell id="hr6" value="Кадровое администрирование" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;fontSize=11;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="960" y="500" width="190" height="55" as="geometry"/></mxCell>

        <!-- Сноска о детализации -->
        <mxCell id="note" value="детализируется в диаграммах BPMN и EPC (рис. 2, 3)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="240" y="610" width="220" height="60" as="geometry"/></mxCell>

        <!-- Связи иерархии HR (выход из низа s1 -> вход в верх подпроцессов) -->
        <mxCell id="eh1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s1" target="hr1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eh2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s1" target="hr2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eh3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s1" target="hr3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eh4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s1" target="hr4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eh5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s1" target="hr5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eh6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s1" target="hr6"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Связь сноски с выделенным процессом -->
        <mxCell id="enote" style="html=1;dashed=1;endArrow=open;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="hr2" target="note"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
