        <mxCell id="t10" value="Провести адаптацию / вводный инструктаж"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;spacing=6;"
