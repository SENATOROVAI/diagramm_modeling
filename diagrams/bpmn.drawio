        <mxCell id="g3" value="Проверка пройдена?"
                style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;"
                vertex="1" parent="1"><mxGeometry x="1930" y="435" width="100" height="70" as="geometry"/></mxCell>
        <mxCell id="end2" value="Кандидату отказано"
