<mxfile host="app.diagrams.net">
  <diagram id="bpmn" name="BPMN — Подбор и приём персонала">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1"
                  connect="1" arrows="1" fold="1" page="1" pageWidth="3050" pageHeight="800"
                  math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Пул и дорожки -->
        <mxCell id="pool" value="ПАО «ОГК-2»"
                style="swimlane;html=1;horizontal=0;startSize=30;fillColor=none;fontStyle=1;fontSize=14;"
                vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="2980" height="720" as="geometry"/>
        </mxCell>
        <mxCell id="laneA" value="Руководитель подразделения"
                style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;"
                vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="2950" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="laneB" value="Отдел подбора (рекрутер)"
                style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;"
                vertex="1" parent="1">
          <mxGeometry x="50" y="200" width="2950" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="laneC" value="Служба безопасности"
                style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;"
                vertex="1" parent="1">
          <mxGeometry x="50" y="380" width="2950" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="laneD" value="Отдел кадров"
                style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;"
                vertex="1" parent="1">
          <mxGeometry x="50" y="560" width="2950" height="180" as="geometry"/>
        </mxCell>

        <!-- Дорожка A: Руководитель -->
        <mxCell id="start" value="Открыта вакансия"
                style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;"
                vertex="1" parent="1"><mxGeometry x="110" y="80" width="64" height="64" as="geometry"/></mxCell>
        <mxCell id="t2" value="Сформировать заявку на подбор"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;spacing=6;"
                vertex="1" parent="1"><mxGeometry x="220" y="82" width="170" height="60" as="geometry"/></mxCell>
        <mxCell id="t3" value="Утвердить заявку"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;spacing=6;"
                vertex="1" parent="1"><mxGeometry x="440" y="82" width="160" height="60" as="geometry"/></mxCell>
        <mxCell id="g1" value="Заявка утверждена?"
                style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;"
                vertex="1" parent="1"><mxGeometry x="650" y="77" width="100" height="70" as="geometry"/></mxCell>
        <mxCell id="end1" value="Подбор отменён"
                style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;fontSize=11;"
                vertex="1" parent="1"><mxGeometry x="850" y="78" width="120" height="68" as="geometry"/></mxCell>
        <mxCell id="data_zayavka" value="Заявка на подбор"
                style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;"
                vertex="1" parent="1"><mxGeometry x="445" y="26" width="150" height="44" as="geometry"/></mxCell>

        <!-- Дорожка B: Рекрутер -->
        <mxCell id="t4" value="Разместить вакансию и вести поиск"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;spacing=6;"
                vertex="1" parent="1"><mxGeometry x="820" y="262" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="t5" value="Провести скрининг резюме"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;spacing=6;"
                vertex="1" parent="1"><mxGeometry x="1060" y="262" width="170" height="60" as="geometry"/></mxCell>
        <mxCell id="t6" value="Провести собеседование"
