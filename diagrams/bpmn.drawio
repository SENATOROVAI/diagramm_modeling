        <mxCell id="endf" value="Сотрудник принят на работу"
                style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;fontSize=11;"
                vertex="1" parent="1"><mxGeometry x="2950" y="618" width="80" height="80" as="geometry"/></mxCell>
        <mxCell id="data_docs" value="Трудовой договор,&#10;приказ Т-1, карточка Т-2"
                style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;"
                vertex="1" parent="1"><mxGeometry x="2490" y="694" width="200" height="42" as="geometry"/></mxCell>

        <!-- Поток управления -->
        <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="start" target="t2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="t2" target="t3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="t3" target="g1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f4" value="нет" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" edge="1" parent="1" source="g1" target="end1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f5" value="да" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="g1" target="t4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f6" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="t4" target="t5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f7" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="t5" target="t6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f8" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="t6" target="g2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f9" value="нет" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.6;entryY=1;" edge="1" parent="1" source="g2" target="t4">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1570" y="360"/><mxPoint x="928" y="360"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="f10" value="да" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="g2" target="t7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f11" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="t7" target="g3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f12" value="нет" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" edge="1" parent="1" source="g3" target="end2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f13" value="да" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="g3" target="t8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f14" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="t8" target="g4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f15" value="нет" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.4;entryY=1;" edge="1" parent="1" source="g4" target="t4">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2370" y="345"/><mxPoint x="892" y="345"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="f16" value="да" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="g4" target="t9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f17" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="t9" target="t10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f18" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="t10" target="endf"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Связи с объектами данных (пунктир) -->
        <mxCell id="d1" style="html=1;dashed=1;endArrow=open;" edge="1" parent="1" source="t2" target="data_zayavka"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d2" style="html=1;dashed=1;endArrow=open;" edge="1" parent="1" source="t4" target="data_resume"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d3" style="html=1;dashed=1;endArrow=open;" edge="1" parent="1" source="t7" target="data_zakl"><mxGeometry relative="1" as="geometry"/></mxCell>
